<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\RTZ_Badge.ico</ApplicationIcon>
    <AssemblyVersion>1.0.0.3</AssemblyVersion>
    <SignAssembly>True</SignAssembly>
    <FileVersion>1.0.0.3</FileVersion>
    <SatelliteResourceLanguages>en-US;cs</SatelliteResourceLanguages>
    <!-- Tvůj kód bude striktně x64 -->
    <PlatformTarget>x64</PlatformTarget>

    <!-- TOTO JE KLÍČOVÉ: Řekne NuGetu, ať stáhne/ponechá pouze knihovny pro Windows x64 a zahodí ARM a x86 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\RTZ_Badge.ico" />
    <None Remove="Assets\RTZ_Badge.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.8" />
	<PackageReference Include="QuestPDF" Version="2026.5.0" />
	<PackageReference Include="ModernWpfUI" Version="0.9.6" />
	<PackageReference Include="SkiaSharp" Version="3.119.4" />
	<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\RTZ_Badge.ico" />
    <Resource Include="Assets\RTZ_Badge.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Přibalení licence -->
    <None Update="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
