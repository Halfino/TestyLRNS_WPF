<Window x:Class="TestyLRNS_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Testy LRNS - Zkušební systém" 
        Width="1280" 
        Height="720" 
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#202020"
        Closing="Window_Closing">

    <Grid>
        <ui:NavigationView x:Name="MainNavigation" 
                           PaneDisplayMode="Left" 
                           IsBackButtonVisible="Collapsed"
                           ItemInvoked="MainNavigation_ItemInvoked">

            <ui:NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Margin="12,10,0,10">
                    <Image Source="/Assets/RTZ_Badge.png" 
       Width="40" Height="40" 
       Stretch="Uniform" 
       HorizontalAlignment="Center" 
       Margin="0,2,5,0"/>
                    <TextBlock Text="LRNS AČR" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Tag="Dashboard" Content="Dashboard">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE80F;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Tag="Persons" Content="Správa techniků">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE716;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Tag="Questions" Content="Databáze otázek">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8F1;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItemSeparator />

                <ui:NavigationViewItem Tag="Generator" Content="Generátor testů">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8A5;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Tag="History" Content="Historie přezkoušení">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8C7;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Tag="Help" Content="Nápověda k systému">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE897;"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Tag="Logout" Content="Odhlásit se" Foreground="#FF6666">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE7E8;" Foreground="#FF4444"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <!-- PŘIDÁNO: Nenápadný copyright v patičce levého menu -->
            <ui:NavigationView.PaneFooter>
                <TextBlock Text="© 2026 prap. Jan Koranda" 
                           FontSize="10" 
                           Foreground="#555555" 
                           HorizontalAlignment="Center" 
                           Margin="0,5,0,10"
                           ToolTip="Autor aplikace"/>
            </ui:NavigationView.PaneFooter>

            <Grid>
                <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" />
                <Frame x:Name="RootFrame" NavigationUIVisibility="Hidden" Visibility="Collapsed"/>
            </Grid>

        </ui:NavigationView>

        <Border x:Name="SyncOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsActive="True" Width="60" Height="60" Foreground="#4DA6FF" Margin="0,0,0,20"/>
                <TextBlock Text="Probíhá ukládání a synchronizace dat..." FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Aplikace se za okamžik sama ukončí." FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>