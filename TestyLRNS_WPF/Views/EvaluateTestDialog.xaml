<Window x:Class="TestyLRNS_WPF.Views.EvaluateTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019" mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Zadání výsledku zkoušky" 
        Height="340" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1E1E1E"
        TextElement.Foreground="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TxtPersonName" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtTestType" FontSize="13" Foreground="Gray" Margin="0,0,0,15"/>

            <Grid Margin="0,5,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Získané body" Foreground="LightGray" Margin="0,0,0,4"/>
                    <ui:NumberBox x:Name="NbScore" Value="0" Minimum="0" SpinButtonPlacementMode="Inline" SmallChange="1" ValueChanged="NbScore_ValueChanged" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,12,0,0">
                    <TextBlock x:Name="TxtPercentage" Text="0 %" FontSize="22" FontWeight="ExtraBold" Foreground="#4DA6FF"/>
                    <TextBlock x:Name="TxtStatus" Text="Neprospěl" FontSize="14" FontWeight="Bold" Foreground="#FF4444"/>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Slovní poznámka / Záznam" Foreground="LightGray" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNote" ui:ControlHelper.PlaceholderText="např. Přezkoušen formou náhradního termínu..." TextWrapping="Wrap" AcceptsReturn="True" Height="65"/>
            </StackPanel>

            <TextBlock x:Name="TxtError" Foreground="#FF4444" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Uložit hodnocení" Width="130" Height="35" Click="BtnSave_Click" 
             Background="#00509E" Foreground="White" Margin="0,0,10,0"/>
            <Button Content="Zrušit" Background="DarkRed" Width="100" Height="35" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>