<Page x:Class="TestyLRNS_WPF.Views.GeneratorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      mc:Ignorable="d"
      Background="Transparent"
      TextElement.Foreground="White"
      Title="GeneratorPage">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" Padding="20" BorderBrush="#333" BorderThickness="1" Margin="0,0,20,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Parametry zkoušky" FontSize="20" FontWeight="SemiBold" Foreground="#4DA6FF" Margin="0,0,0,18"/>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Základna (Letiště)" Foreground="LightGray" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CbBase" HorizontalAlignment="Stretch" SelectionChanged="CbBaseOrUnit_SelectionChanged"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Odbornost" Foreground="LightGray" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CbUnit" HorizontalAlignment="Stretch" SelectionChanged="CbBaseOrUnit_SelectionChanged">
                        <ComboBoxItem Content="SZP"/>
                        <ComboBoxItem Content="RNS"/>
                        <ComboBoxItem Content="RSP"/>
                        <ComboBoxItem Content="OSZ"/>
                        <ComboBoxItem Content="LSLPS"/>
                    </ComboBox>
                </StackPanel>

                <Rectangle Height="1" Fill="#333" Margin="0,5,0,23"/>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Druh testu" Foreground="LightGray" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CbTestType" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="CbTestType_SelectionChanged">
                        <ComboBoxItem Content="Průřezový test (Všechna témata)"/>
                        <ComboBoxItem Content="Postupový test typového výcviku (Teorie)"/>
                        <ComboBoxItem Content="Postupový test typového výcviku (Provozní)"/>
                        <ComboBoxItem Content="Závěrečný test typového výcviku"/>
                        <ComboBoxItem Content="Průběžný test dle tématu"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Konkrétní téma (Systém)" Foreground="LightGray" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CbTopic" HorizontalAlignment="Stretch" IsEnabled="False" ui:ControlHelper.PlaceholderText="Vyberte téma..."/>
                </StackPanel>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Počet otázek v testu" Foreground="LightGray" Margin="0,0,0,4"/>
                    <ui:NumberBox x:Name="NbQuestionCount" Value="30" Minimum="5" Maximum="100" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <TextBlock x:Name="TxtStatus" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>

                <Button x:Name="BtnGenerate" Background="#00509E" Foreground="White" HorizontalAlignment="Stretch" Height="45" Margin="0,10,0,0" Click="BtnGenerate_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:FontIcon Glyph="&#xE8A5;" FontSize="18" Margin="0,0,10,0"/>
                        <TextBlock Text="Vygenerovat zkoušky" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" Padding="20" BorderBrush="#333" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Testovaní technici" FontSize="20" FontWeight="SemiBold" Foreground="#4DA6FF" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Vybrat všechny" Background="#00509E" Click="BtnSelectAll_Click" Margin="0,0,10,0"/>
                    <Button Content="Zrušit výběr" Background="#00509E" Click="BtnDeselectAll_Click"/>
                </StackPanel>

                <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="10,5,10,5" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Jméno a příjmení" FontWeight="Bold" Foreground="Gray"/>
                        <TextBlock Grid.Column="1" Text="Znalostní třída" FontWeight="Bold" Foreground="Gray"/>
                        <TextBlock Grid.Column="2" Text="Platnost do" FontWeight="Bold" Foreground="Gray"/>
                    </Grid>
                </Border>

                <ListBox x:Name="LvPersons" Grid.Row="2" SelectionMode="Multiple" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding FullNameWithRank}" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding KnowledgeClassText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ValidUntilString}" VerticalAlignment="Center" Foreground="Gray"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

    </Grid>
</Page>