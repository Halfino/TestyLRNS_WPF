<Page x:Class="TestyLRNS_WPF.Views.PersonsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      mc:Ignorable="d"
      Background="Transparent"
      TextElement.Foreground="White"
      Title="PersonsPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">

            <Border Background="#2D2D2D" CornerRadius="4" Padding="8,0,8,0" Margin="0,0,15,0">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE721;" FontSize="16" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtSearch" Width="260" ui:ControlHelper.PlaceholderText="Hledat technika podle jména..." 
                             BorderThickness="0" Background="Transparent" TextChanged="TxtSearch_TextChanged" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Button Click="BtnAddPerson_Click" Background="#00509E" Foreground="White">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE710;" Margin="0,0,8,0"/>
                    <TextBlock Text="Přidat nového technika" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Grid.Row="1" Background="#202020" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="10,5,10,10" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Grid.ColumnSpan="5" Margin="-10,0,-10,0" VerticalAlignment="Bottom"/>

                        <TextBlock Grid.Column="0" Text="Hodnost, Jméno a Příjmení" FontWeight="Bold" Foreground="Gray"/>
                        <TextBlock Grid.Column="1" Text="Odbornost" FontWeight="Bold" Foreground="Gray"/>
                        <TextBlock Grid.Column="2" Text="Třída znalostí" FontWeight="Bold" Foreground="Gray"/>
                        <TextBlock Grid.Column="3" Text="Platnost přezkoušení" FontWeight="Bold" Foreground="Gray"/>
                        <TextBlock Grid.Column="4" Text="Akce" FontWeight="Bold" Foreground="Gray" TextAlignment="Center"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LvPersons">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,5,10,5">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding FullNameWithRank}" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Unit}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding KnowledgeClassText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding ValidUntilString}" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Click="BtnEdit_Click" Tag="{Binding Id}" Margin="0,0,10,0" Padding="6">
                                                <ui:FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                            </Button>
                                            <Button Click="BtnDelete_Click" Tag="{Binding Id}" Padding="6">
                                                <ui:FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#FF4444"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>