<Page x:Class="TestyLRNS_WPF.Views.QuestionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      mc:Ignorable="d"
      Background="Transparent"
      TextElement.Foreground="White"
      Title="QuestionsPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,20">

            <Border Background="#2D2D2D" CornerRadius="4" Padding="8,0,8,0" Margin="0,0,12,12">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE721;" FontSize="16" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtSearch" Width="220" ui:ControlHelper.PlaceholderText="Hledat v textu otázky..." 
                             BorderThickness="0" Background="Transparent" TextChanged="TxtSearch_TextChanged" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ComboBox x:Name="CbUnitFilter" ui:ControlHelper.PlaceholderText="Odbornost" Width="130" SelectionChanged="CbUnitFilter_SelectionChanged" Margin="0,0,12,12">
                <ComboBoxItem Content="Všechny"/>
                <ComboBoxItem Content="SZP"/>
                <ComboBoxItem Content="RNS"/>
                <ComboBoxItem Content="RSP"/>
                <ComboBoxItem Content="OSZ"/>
                <ComboBoxItem Content="LSLPS"/>
            </ComboBox>

            <ComboBox x:Name="CbTopicFilter" ui:ControlHelper.PlaceholderText="Systém / Téma" Width="150" SelectionChanged="FilterSelectionChanged" Margin="0,0,12,12" />

            <ComboBox x:Name="CbClassFilter" ui:ControlHelper.PlaceholderText="Třída znalostí" Width="140" SelectionChanged="FilterSelectionChanged" Margin="0,0,12,12">
                <ComboBoxItem Content="Všechny třídy"/>
                <ComboBoxItem Content="3. třída"/>
                <ComboBoxItem Content="2. třída"/>
                <ComboBoxItem Content="1. třída"/>
            </ComboBox>

            <ComboBox x:Name="CbLocalityFilter" ui:ControlHelper.PlaceholderText="Rozsah / Lokalita" Width="150" SelectionChanged="FilterSelectionChanged" Margin="0,0,12,12">
                <ComboBoxItem Content="Všechny"/>
                <ComboBoxItem Content="Pouze Globální"/>
                <ComboBoxItem Content="Pouze Místní"/>
            </ComboBox>

            <ComboBox x:Name="CbOperationalFilter" ui:ControlHelper.PlaceholderText="Provozní výcvik" Width="150" SelectionChanged="FilterSelectionChanged" Margin="0,0,12,12">
                <ComboBoxItem Content="Všechny otázky"/>
                <ComboBoxItem Content="Pouze provozní výcvik"/>
                <ComboBoxItem Content="Bez provozního výcviku"/>
            </ComboBox>

            <Button Click="BtnAddQuestion_Click" Background="#00509E" Foreground="White" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE710;" Margin="0,0,8,0"/>
                    <TextBlock Text="Nová otázka" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </WrapPanel>

        <Border Grid.Row="1" Background="#202020" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="10,5,10,10" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Grid.ColumnSpan="8" Margin="-10,0,-10,0" VerticalAlignment="Bottom"/>

                        <TextBlock Grid.Column="0" Text="Znění otázky" FontWeight="Bold" Foreground="Gray"/>
                        <TextBlock Grid.Column="1" Text="Téma" FontWeight="Bold" Foreground="Gray"/>
                        <TextBlock Grid.Column="2" Text="Typ otázky" FontWeight="Bold" Foreground="Gray"/>
                        <TextBlock Grid.Column="3" Text="Třída" FontWeight="Bold" Foreground="Gray"/>
                        <TextBlock Grid.Column="4" Text="Provozní" FontWeight="Bold" Foreground="Gray"/>
                        <TextBlock Grid.Column="5" Text="Lokalita" FontWeight="Bold" Foreground="Gray"/>
                        <TextBlock Grid.Column="6" Text="Vlastník" FontWeight="Bold" Foreground="Gray"/>
                        <TextBlock Grid.Column="7" Text="Akce" FontWeight="Bold" Foreground="Gray" TextAlignment="Center"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LvQuestions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8,10,8">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" FontSize="14"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SystemTopicString}" VerticalAlignment="Center" Foreground="#4DA6FF" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TypeString}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding KnowledgeClassString}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding IsOperationalString}" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding OperationalColor}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding LocalityString}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="6" Text="{Binding OwnerName}" VerticalAlignment="Center" Foreground="LightGray" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>

                                        <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Click="BtnEdit_Click" Tag="{Binding Id}" Margin="0,0,10,0" Padding="6" IsEnabled="{Binding CanEdit}">
                                                <ui:FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                            </Button>
                                            <Button Click="BtnDelete_Click" Tag="{Binding Id}" Padding="6" IsEnabled="{Binding CanEdit}">
                                                <ui:FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#FF4444"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>