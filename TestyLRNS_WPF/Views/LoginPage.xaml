<Page x:Class="TestyLRNS_WPF.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      mc:Ignorable="d"
      Background="#141414"
      Title="LoginPage">

    <Grid>
        <Border Background="#1E1E1E" CornerRadius="12" Padding="40" 
                Width="400" VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="#333333" BorderThickness="1">

            <StackPanel>
                <ui:FontIcon Glyph="&#xE707;" FontSize="56" Foreground="#00509E" Margin="0,0,0,15"/>
                <TextBlock Text="Zkušební systém LRNS" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" Margin="0,0,0,5"/>
                <TextBlock Text="Přihlaste se ke svému účtu" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Uživatelské jméno" Foreground="LightGray" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtUsername" ui:ControlHelper.PlaceholderText="např. novakj" KeyDown="Input_KeyDown"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Heslo" Foreground="LightGray" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtPassword" ui:ControlHelper.PlaceholderText="Zadejte heslo" KeyDown="Input_KeyDown"/>
                </StackPanel>

                <TextBlock x:Name="TxtError" Foreground="#FF4444" Visibility="Collapsed" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"/>

                <Button Content="Přihlásit se" HorizontalAlignment="Stretch" Height="40"
                        Background="#00509E" Foreground="White" 
                        Click="BtnLogin_Click"/>
            </StackPanel>

        </Border>
    </Grid>
</Page>