<Page x:Class="TestyLRNS_WPF.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      mc:Ignorable="d"
      Background="Transparent"
      TextElement.Foreground="White"
      Title="SettingsPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Nastavení a správa systému" FontSize="28" FontWeight="Bold" Margin="0,0,0,25"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">

                    <Border Background="#1E1E1E" CornerRadius="8" Padding="20" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Změna vašeho hesla" FontSize="18" FontWeight="SemiBold" Foreground="#4DA6FF" Margin="0,0,0,15"/>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Současné heslo" Foreground="LightGray" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="TxtCurrentPassword" ui:ControlHelper.PlaceholderText="Zadejte nynější heslo"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Nové heslo" Foreground="LightGray" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="TxtNewPassword" ui:ControlHelper.PlaceholderText="Zadejte nové heslo"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Potvrzení nového hesla" Foreground="LightGray" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="TxtConfirmPassword" ui:ControlHelper.PlaceholderText="Opakujte nové heslo"/>
                            </StackPanel>

                            <TextBlock x:Name="TxtPasswordMessage" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,0,0,10"/>

                            <Button Content="Změnit heslo" Background="#00509E" Foreground="White" Width="130" Height="35" Click="BtnChangePassword_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="BorderAdminLink" Background="#1E1E1E" CornerRadius="8" Padding="20" BorderBrush="#333333" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Odpovědná osoba za účet" FontSize="18" FontWeight="SemiBold" Foreground="#4DA6FF" Margin="0,0,0,10"/>
                            <TextBlock Text="Přiřaďte k tomuto funkčnímu účtu konkrétního vojenského technika. Jeho nacionále se budou propisovat do vygenerovaných testů." 
                                       Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Aktuálně sloužící správce" Foreground="LightGray" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CbAdminLinkedPerson" HorizontalAlignment="Stretch" ui:ControlHelper.PlaceholderText="Vyberte technika ze základny..."/>
                            </StackPanel>

                            <TextBlock x:Name="TxtAdminLinkMessage" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,0,0,10"/>

                            <Button Content="Uložit osobu" Background="#00509E" Foreground="White" Width="130" Height="35" Click="BtnSaveAdminLink_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" x:Name="BorderCreateUser" Background="#1E1E1E" CornerRadius="8" Padding="20" BorderBrush="#333333" BorderThickness="1" VerticalAlignment="Top" Margin="15,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Vytvořit nový přístupový účet" FontSize="18" FontWeight="SemiBold" Foreground="#4DA6FF" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtUserFormDescription" Text="Vytvoření nového účtu pro personál základny." Foreground="Gray" FontSize="12" Margin="0,0,0,20"/>

                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.6*"/>
                                    <ColumnDefinition Width="0.6*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Hodnost" Foreground="LightGray" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtNewRank" ui:ControlHelper.PlaceholderText="např. npor."/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Titul" Foreground="LightGray" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtNewTitle" ui:ControlHelper.PlaceholderText="Ing."/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="Jméno" Foreground="LightGray" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtNewFirstName" ui:ControlHelper.PlaceholderText="Jan"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Příjmení" Foreground="LightGray" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtNewLastName" ui:ControlHelper.PlaceholderText="Novák"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Výchozí heslo" Foreground="LightGray" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="TxtNewUserPassword" ui:ControlHelper.PlaceholderText="Zadejte heslo"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="Vygenerovaný Login" Foreground="Gray" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtGeneratedLoginPreview" Text="Zadejte jméno..." Foreground="#4DA6FF" FontWeight="Bold" FontSize="15" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Role v systému" Foreground="LightGray" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CbNewRole" HorizontalAlignment="Stretch" SelectionChanged="CbNewRole_SelectionChanged">
                                        <ComboBoxItem Content="Instruktor"/>
                                        <ComboBoxItem Content="LokalniAdmin"/>
                                        <ComboBoxItem Content="SuperAdmin"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Odbornost" Foreground="LightGray" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CbNewUnit" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Žák / Všeobecná"/>
                                        <ComboBoxItem Content="SZP"/>
                                        <ComboBoxItem Content="RNS"/>
                                        <ComboBoxItem Content="RSP"/>
                                        <ComboBoxItem Content="OSZ"/>
                                        <ComboBoxItem Content="LSLPS"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Letiště" Foreground="LightGray" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CbNewAirport" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Globální platnost"/>
                                        <ComboBoxItem Content="LKKB (Kbely)"/>
                                        <ComboBoxItem Content="LKCV (Čáslav)"/>
                                        <ComboBoxItem Content="LKNA (Náměšť)"/>
                                        <ComboBoxItem Content="LKPD (Pardubice)"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Kvalifikace" Foreground="LightGray" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CbPersonClass" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Instruktor (Třída 4)"/>
                                        <ComboBoxItem Content="Inspektor (Třída 5)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <TextBlock x:Name="TxtUserMessage" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,0,0,10"/>
                        <Button x:Name="BtnCreateUser" Content="Vytvořit účet a kartu" Background="#00509E" Foreground="White" Width="170" Height="38" Click="BtnCreateUser_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" x:Name="BorderUsersTable" Background="#1E1E1E" CornerRadius="8" Padding="20" BorderBrush="#333333" BorderThickness="1" Margin="0,25,0,0">
                <StackPanel>
                    <TextBlock Text="Přehled spravovaných účtů" FontSize="18" FontWeight="SemiBold" Foreground="#4DA6FF" Margin="0,0,0,15"/>

                    <Border Padding="10,5,10,10" Margin="0,0,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Grid.ColumnSpan="5" Margin="-10,0,-10,0" VerticalAlignment="Bottom"/>

                            <TextBlock Grid.Column="0" Text="Uživatelské jméno" FontWeight="Bold" Foreground="Gray"/>
                            <TextBlock Grid.Column="1" Text="Role" FontWeight="Bold" Foreground="Gray"/>
                            <TextBlock Grid.Column="2" Text="Odbornost" FontWeight="Bold" Foreground="Gray"/>
                            <TextBlock Grid.Column="3" Text="Základna" FontWeight="Bold" Foreground="Gray"/>
                            <TextBlock Grid.Column="4" Text="Akce" FontWeight="Bold" Foreground="Gray" TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LvUsers">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,6,10,6" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Username}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Foreground="#4DA6FF"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Role}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding UnitString}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding AirportString}" VerticalAlignment="Center"/>

                                            <Button Grid.Column="4" Click="BtnDeleteUser_Click" Tag="{Binding Id}" Width="40" Height="32" HorizontalAlignment="Center" Padding="0">
                                                <ui:FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#FF4444"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>