<Page x:Class="TestyLRNS_WPF.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      mc:Ignorable="d"
      Background="Transparent"
      TextElement.Foreground="White"
      Title="DashboardPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#2D2D2D" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE7BA;" FontSize="32" Foreground="#FF4444" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <StackPanel>
                            <TextBlock Text="Expirující přezkoušení" FontSize="14" Foreground="Gray"/>
                            <TextBlock x:Name="TxtExpiringCount" Text="0" FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#2D2D2D" CornerRadius="8" Padding="15" Margin="10,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE91C;" FontSize="32" Foreground="#FFCC00" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <StackPanel>
                            <TextBlock Text="Testy k vyhodnocení" FontSize="14" Foreground="Gray"/>
                            <TextBlock x:Name="TxtPendingTestsCount" Text="0" FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#2D2D2D" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE8F1;" FontSize="32" Foreground="#00509E" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <StackPanel>
                            <TextBlock Text="Otázky tvé odbornosti" FontSize="14" Foreground="Gray"/>
                            <TextBlock x:Name="TxtTotalQuestionsCount" Text="0" FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,25,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Generované testy čekající na vyhodnocení" FontSize="16" FontWeight="Bold" Foreground="#4DA6FF" Margin="0,0,0,10"/>
                    <Border Background="#202020" CornerRadius="8" Padding="10" MinHeight="250">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="5" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Grid.ColumnSpan="3" Margin="-5,0,-5,0" VerticalAlignment="Bottom"/>

                                    <TextBlock Grid.Column="0" Text="Zkoušený technik" FontWeight="Bold" Foreground="Gray"/>
                                    <TextBlock Grid.Column="1" Text="Typ testu" FontWeight="Bold" Foreground="Gray"/>
                                    <TextBlock Grid.Column="2" Text="Akce" FontWeight="Bold" Foreground="Gray" TextAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="LvPendingTests">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="5,8" BorderBrush="#333" BorderThickness="0,0,0,1">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding PersonName}" VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TestType}" VerticalAlignment="Center" Foreground="Gray" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                    <Button Grid.Column="2" Content="Zadat výsledek" Click="BtnEvaluate_Click" Tag="{Binding TestId}" Background="DarkBlue" Foreground="White" Padding="10,5" Height="32" HorizontalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                    <TextBlock Text="Technici s končící / propadlou platností" FontSize="16" FontWeight="Bold" Foreground="#FF4444" Margin="0,0,0,10"/>
                    <Border Background="#202020" CornerRadius="8" Padding="10" MinHeight="250">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="5" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Grid.ColumnSpan="3" Margin="-5,0,-5,0" VerticalAlignment="Bottom"/>

                                    <TextBlock Grid.Column="0" Text="Technik" FontWeight="Bold" Foreground="Gray"/>
                                    <TextBlock Grid.Column="1" Text="Odbornost" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Platnost do" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="LvExpiringPersons">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="5,8" BorderBrush="#333" BorderThickness="0,0,0,1">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="160"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Unit}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#4DA6FF" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding ValidUntilString}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#FF4444" FontWeight="Bold"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>